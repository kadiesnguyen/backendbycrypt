# PRODUCTION — copy to `.env.production.local` on the server BEFORE `npm run build`
# Next.js bakes NEXT_PUBLIC_* at build time. Wrong value = login hits localhost.
#
# bycrypt prod:
NEXT_PUBLIC_ADMIN_API_URL=https://cms.bycrypt.net/api/admin
#
# Do NOT put localhost here. Do NOT commit real `.env.production.local`.
